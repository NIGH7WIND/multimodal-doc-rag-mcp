# Local LLM Server (llama.cpp / Ollama OpenAI-compatible endpoint)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=local-no-key
LLM_MODEL=gemma-4-e4b

# Target Documentation Site (for scraper.py)
DOCS_BASE_URL=https://docs.example.com/getting-started
DOCS_DOMAIN=https://docs.example.com

# Storage & Embedding Cache Paths
RAW_DOCS_DIR=./data/raw_docs
CLEAN_DOCS_DIR=./data/clean_docs
LANCEDB_DIR=./lancedb_store
LANCEDB_TABLE=technical_docs
EMBED_MODEL=BAAI/bge-base-en-v1.5
FASTEMBED_CACHE_DIR=./.fastembed_cache
